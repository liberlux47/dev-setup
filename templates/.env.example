# Environment variables — copy to .env and fill in real values.
# NEVER commit real secrets. This file only documents what exists.

# --- Application ---
# Port the service listens on.
PORT=8080
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Base URL the service is publicly reachable at.
PUBLIC_URL=http://localhost:8080

# --- Database (example) ---
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# --- Auth (example — NEVER commit real keys) ---
# JWT_SECRET=change-me-to-a-long-random-value
# API_KEY=change-me

# --- CI / tooling (example) ---
# GITHUB_TOKEN=ghp_xxx   # only used locally, never committed